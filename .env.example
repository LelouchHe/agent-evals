# Copy this file to .env in the directory where you invoke `agent-evals`.
# Implementation parameters can reference a value from this file, for example:
#   apiKey: ${env:OPENCODE_API_KEY}
# Only referenced names are read from this file.

# Plain value (synthetic example only; do not commit a real key):
# OPENCODE_API_KEY=replace-with-key

# Or an explicit trusted local lookup command, executed from that directory:
# OPENCODE_API_KEY="!security find-generic-password -w -s opencode-api-key"

# ACP runner and preparation helpers: caller-owned software and login directories.
# Install the native program, ACP adapter and runtime under deps before use.
# PI_DEPS=/absolute/path/to/agent-evals-home/pi/deps
# PI_LOGIN=/absolute/path/to/agent-evals-home/pi/login
# CLAUDE_DEPS=/absolute/path/to/agent-evals-home/claude/deps
# CLAUDE_LOGIN=/absolute/path/to/agent-evals-home/claude/login
# COPILOT_DEPS=/absolute/path/to/agent-evals-home/copilot/deps
# COPILOT_LOGIN=/absolute/path/to/agent-evals-home/copilot/login
# A `claude setup-token` token stored in the keychain:
# CLAUDE_OAUTH_TOKEN="!security find-generic-password -w -s claude-oauth-token"

# Other referenced names can be used, for example:
# DEEPSEEK_API_KEY=replace-with-key
# DEEPSEEK_API_KEY="!op read op://private/deepseek/api-key"
